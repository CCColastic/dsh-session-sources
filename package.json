{
  "name": "@local/dsh-session-sources",
  "version": "0.1.3",
  "description": "Recover images, files and explicit links from the current conversation.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/CCColastic/dsh-session-sources.git" },
  "keywords": ["deepseek-harness", "dsh-plugin", "sidebar", "attachments", "links"],
  "engines": { "dsh": ">=0.2.1-rc.5 <0.2.2-0", "node": ">=22" },
  "exports": {
    ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "src/*.js", "src/*.css", "scripts/build.mjs", "tests/*.test.mjs", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "README_ZH.md", "LICENSE", "docs/*.md", "docs/*.json"],
  "scripts": { "build": "node scripts/build.mjs", "test": "node --test tests/*.test.mjs" },
  "dependencies": { "zod": "4.4.3" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web", "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
